{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hakkabon/Grammar-REPL/Schemas/ExperimentProject.schema.json",
  "title": "Grammar-REPL Experiment Project",
  "description": "A deterministic collection of independently replayable Grammar-REPL experiment documents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "producer",
    "name",
    "experiments",
    "fingerprintAlgorithm",
    "fingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "producer": { "$ref": "#/$defs/producer" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "experiments": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "fingerprintAlgorithm": { "const": "fnv1a64" },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tags", "experiment"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "experiment": {
          "type": "object",
          "description": "A complete REPLExperimentDocument, validated by Grammar-REPL's fail-closed decoder.",
          "required": [
            "schemaVersion",
            "producer",
            "grammar",
            "input",
            "engines",
            "precedence",
            "agreement",
            "observations",
            "fingerprintAlgorithm",
            "fingerprint"
          ]
        }
      }
    }
  }
}
